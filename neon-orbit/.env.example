# ─────────────────────────────────────────────────────────────
#  NEON ORBIT — environment configuration
#  Copy to `.env` (never commit the real file).
# ─────────────────────────────────────────────────────────────

# ── Google Earth Engine (server-side only, never shipped to the browser) ──
# Google Cloud project that is registered for Earth Engine
# (https://code.earthengine.google.com/register — "noncommercial" is free).
EE_PROJECT_ID=

# Service-account key with the "Earth Engine Resource Viewer" role (or wider).
# Paste the whole JSON on one line, OR base64-encode it, OR point at a file.
EE_SERVICE_ACCOUNT_JSON=
# EE_SERVICE_ACCOUNT_FILE=./secrets/ee-service-account.json

# ── Optional browser-side keys (these ARE visible to visitors — restrict them
#    by HTTP referrer in the provider's console) ──
# Cesium ion token → unlocks Cesium World Terrain + Bing aerial imagery.
VITE_CESIUM_ION_TOKEN=
# Google Maps Platform key with the Map Tiles API enabled → Photorealistic 3D Tiles.
VITE_GOOGLE_MAPS_API_KEY=
